<% response_option = form.object %>

<div class="card questionnaire-question-response-option">
  <div class="card-divider">
    <h2 class="card-title">
    <span><%= t(".response_option") %></span>
    <% if editable %>
      <button class="button button__sm button__transparent-secondary small alert hollow remove-response-option button--title mb-2">
        <%= icon("delete-bin-line") %>
        <%= t(".remove") %>
      </button>
    <% end %>
    </h2>
  </div>

  <div class="card-section">
    <div class="row column">
      <%=
        form.translated(
          :text_field,
          :body,
          tabs_id: tabs_id_for_question_response_option(question, response_option),
          label: t(".statement"),
          disabled: !editable
        )
      %>
    </div>

    <div class="row column questionnaire-question-response-option-free-text">
      <%=
        form.check_box(
          :free_text,
          label: t(".free_text"),
          disabled: !questionnaire.questions_editable?
        )
      %>
    </div>

    <div class="row column location-field">
      <%=
        form.text_area(
          :geojson,
          tabs_id: tabs_id_for_question_response_option(question, response_option),
          label: t(".geojson"),
          disabled: !editable
        )
      %>
      <p class="help-text"><%= t(".geojson_help") %></p>
      <% if editable %>
        <%= form.button t(".define"), type: "button", class: "button button__sm button__secondary mt-2 location-option-define" %>
      <% end %>
    </div>

    <div class="row column location-field">
      <%=
        form.select(
          :tooltip_direction,
          options_for_select(
            [
              [t(".left"), "left"],
              [t(".right"), "right"],
              [t(".top"), "top"],
              [t(".bottom"), "bottom"],
              [t(".center"), "center"]
            ],
            response_option.tooltip_direction
          ),
          {},
          label: t(".tooltip_direction"),
          disabled: !editable
        )
      %>
    </div>
  </div>

  <% if response_option.persisted? %>
    <%= form.hidden_field :id, disabled: !editable %>
  <% end %>

  <%= form.hidden_field :deleted, disabled: !editable %>
</div>
